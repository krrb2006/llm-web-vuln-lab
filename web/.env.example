# 复制为 .env 后修改，至少改掉三个密码/密钥
HTTP_PORT=8080

MYSQL_DATABASE=vulnlab
MYSQL_USER=vulnlab
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# 用于签发登录令牌，务必换成随机长字符串：openssl rand -hex 32
JWT_SECRET=change-me-random-secret

# 上传与分析限制
MAX_UPLOAD_MB=20
MAX_FILES=3000
DAILY_JOB_LIMIT=10
MAX_LLM_FINDINGS=8

# 演示账号（SEED_DEMO=false 时不会创建）
SEED_DEMO=true
DEMO_EMAIL=demo@vulnlab.local
DEMO_PASSWORD=demo-vulnlab-2026

# 是否允许自助注册
ALLOW_REGISTER=true
