{
  "name": "dvwa",
  "networks": {
    "dvwa": {
      "name": "dvwa_dvwa",
      "ipam": {}
    }
  },
  "services": {
    "db": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "MYSQL_DATABASE": "dvwa",
        "MYSQL_PASSWORD": "<redacted>",
        "MYSQL_ROOT_PASSWORD": "<redacted>",
        "MYSQL_USER": "dvwa"
      },
      "image": "ghcr.io/mariadb/mariadb@sha256:9d7f7220a4d9b9f5a70a845241bba5ffe94788fb2f7913ff7c8fa3cf28b5715a",
      "networks": {
        "dvwa": null
      },
      "pull_policy": "missing",
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "dvwa",
          "target": "/var/lib/mysql",
          "volume": {}
        }
      ]
    },
    "dvwa": {
      "build": {
        "context": "<repo>\\third_party\\DVWA",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "depends_on": {
        "db": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "DB_HOST": "db",
        "DB_NAME": "teaching_lab",
        "DB_PASSWORD": "<redacted>",
        "DB_PORT": "3306",
        "DB_SERVER": "db",
        "DB_USER": "lab_user"
      },
      "image": "ghcr.io/digininja/dvwa@sha256:1af2cedda7617e4d22937e61c98bbf71d8b74b98e46f5e41dd6aa0a5183311b0",
      "networks": {
        "dvwa": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 80,
          "published": "4280",
          "protocol": "tcp"
        }
      ],
      "pull_policy": "missing",
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "<repo>\\local\\lab_cases",
          "target": "/var/www/html/lab_cases",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "<repo>\\local\\dvwa_config.inc.php",
          "target": "/var/www/html/config/config.inc.php",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  },
  "volumes": {
    "dvwa": {
      "name": "dvwa_dvwa"
    }
  }
}
